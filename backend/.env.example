# PyroGuard AI Environment Configuration

# Google Earth Engine Configuration
# Provide your GCP Project ID with Earth Engine API enabled
GEE_PROJECT_ID=your-gcp-project-id
# Optional: Service account credentials (if running headless)
# GEE_SERVICE_ACCOUNT_EMAIL=sa@your-gcp-project-id.iam.gserviceaccount.com
# GEE_PRIVATE_KEY_PATH=/path/to/key.json

# NASA FIRMS API Key for Active Hotspots
# Register free at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SIMULATION_MODE=auto  # 'auto' falls back to simulation if credentials fail or are offline

